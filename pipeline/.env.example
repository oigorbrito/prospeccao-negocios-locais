# Copie este arquivo para .env e preencha. Nunca commite o .env.
# Nenhuma chave de API é necessária para o teste com OpenStreetMap.

# Nome do seu negócio, como aparece nas mensagens e no rodapé dos sites
ESTUDIO=Nome do seu estúdio

# Endereço público onde os sites serão publicados (vazio = a fila não gera mensagens)
SITE_BASE_URL=

# Mensagens por dia (aceito de 20 a 30)
LIMITE_DIARIO=25
